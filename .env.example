# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore.

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Chỉ đặt khi auto-detect Google Drive sai.
# macOS (Drive for desktop v60+):
# HERMES_DRIVE_ROOT=/Users/<user>/Library/CloudStorage/GoogleDrive-<email>/My Drive
# Windows:
# HERMES_DRIVE_ROOT=G:/My Drive

# Ghi đè thư mục output nếu muốn tránh tên có dấu ("Đã Lọc")
# HERMES_RAW_DIR=/Users/<user>/HermesData/raw
# HERMES_FILTERED_DIR=/Users/<user>/HermesData/filtered

# Ghi đè đường dẫn Chrome nếu cài ở vị trí không chuẩn
# CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
